@using Tp01.Models
@{
    ViewData["Title"] = "Perfil";
    Integrante integrante = (Integrante)ViewBag.Integrante;
}

<link rel="stylesheet" href="~/css/site.css" />

@if (integrante != null)
{
    <div class="pagina">
        <div class="perfil-header">
            <img src="@integrante.Foto" class="foto-grande" alt="Foto de @integrante.Nombre" />
            <div class="perfil-titulo">
                <h1>@integrante.Nombre</h1>
                <span class="badge-dni">DNI @integrante.DNI</span>
            </div>
        </div>

        <div class="secciones">
            <div class="seccion">
                <h3>Datos personales</h3>
                <p><span class="etiqueta">Nombre</span> @integrante.Nombre</p>
                <p><span class="etiqueta">DNI</span> @integrante.DNI</p>
                <p><span class="etiqueta">Nacimiento</span> @integrante.FechaNacimiento.ToShortDateString()</p>
            </div>

            <div class="seccion">
                <h3>Familia</h3>
                <ul>
                    @foreach (var f in integrante.Familiares)
                    {
                        <li>@f</li>
                    }
                </ul>
            </div>

            <div class="seccion">
                <h3>Intereses</h3>
                <ul>
                    @foreach (var i in integrante.Intereses)
                    {
                        <li>@i</li>
                    }
                </ul>
            </div>
        </div>

        <a class="btn-volver" href='@Url.Action("Index", "Home")'>← Volver al grupo</a>
    </div>
}
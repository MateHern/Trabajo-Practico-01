@using Tp01.Models
@{
    ViewData["Title"] = "Nuestro Grupo";
    var integrantes = ViewBag.Integrantes as Dictionary<int, Integrante>;
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="pagina">
    <header class="encabezado">
        <div class="logo-grupo">Tp01</div>
        <div>
            <h1>El mejor grupo de toda programacion</h1>
            <p class="subtitulo">Vamos binker por nuestra S</p>
        </div>
    </header>

    <div class="grilla">
        @if (integrantes != null)
        {
            @foreach (var item in integrantes.Values)
            {
                <div class="tarjeta">
                    <img src="@item.Foto" class="foto-chiquita" alt="Foto de @item.Nombre" />
                    <h2>@item.Nombre</h2>
                    <a class="btn-ver" href='@Url.Action("SelectIntegrante", "Home", new { dni = item.DNI })'>
                        Ver perfil
                    </a>
                </div>
            }
        }
    </div>
</div>